{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc",
    "test": "vitest --run",
    "test:watch": "vitest",
    "build": "tsc && vite build",
    "preview": "vite preview",
